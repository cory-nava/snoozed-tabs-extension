{
  "manifest_version": 3,
  "name": "Snoozed Tabs",
  "description": "Snooze tabs for later viewing with flexible scheduling options",
  "version": "1.0.0",
  "key": "",
  "author": "Cory Nava",
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "contextMenus",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Snooze Tab",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
