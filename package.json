{
  "name": "snoozed-tabs-extension",
  "version": "1.0.0",
  "description": "Chrome extension to snooze tabs for later viewing with flexible scheduling options",
  "main": "background.js",
  "scripts": {
    "test": "jest",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "lint": "eslint .",
    "build": "npm run lint && npm test",
    "package": "web-ext build --ignore-files '*.md' 'package*.json' 'node_modules' '.git*' 'tests' 'docs' 'coverage' 'babel.config.json' 'playwright.config.js'",
    "screenshots": "node scripts/capture-screenshots.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cory-nava/snoozed-tabs-extension.git"
  },
  "keywords": [
    "chrome-extension",
    "tab-management",
    "productivity",
    "snooze",
    "browser-extension",
    "tab-organizer"
  ],
  "author": "Cory Nava <corytrimm@navapbc.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cory-nava/snoozed-tabs-extension/issues"
  },
  "homepage": "https://github.com/cory-nava/snoozed-tabs-extension#readme",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@playwright/test": "^1.64.1",
    "babel-jest": "^29.7.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "web-ext": "^7.8.0"
  },
  "engines": {
    "node": ">=18"
  },
  "browserslist": [
    "Chrome >= 88"
  ],
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/tests/globalSetup.js",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/e2e/"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "background/**/*.js",
      "utils/**/*.js",
      "popup/**/*.js"
    ]
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2021": true,
      "webextensions": true
    },
    "extends": [
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 2021,
      "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": "warn",
      "no-console": "off",
      "semi": [
        "error",
        "always"
      ],
      "quotes": [
        "error",
        "single"
      ]
    },
    "globals": {
      "chrome": "readonly"
    },
    "ignorePatterns": [
      "node_modules/",
      "coverage/",
      "playwright-report/",
      "test-results/"
    ],
    "overrides": [
      {
        "files": [
          "tests/**/*.js"
        ],
        "env": {
          "jest": true,
          "node": true
        }
      },
      {
        "files": [
          "playwright.config.js",
          "tests/globalSetup.js",
          "tests/e2e/**/*.js",
          "scripts/**/*.js"
        ],
        "env": {
          "node": true
        },
        "parserOptions": {
          "sourceType": "script"
        }
      }
    ]
  }
}
