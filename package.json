{
  "name": "snoozed-tabs-extension",
  "version": "1.1.0",
  "description": "Chrome extension to snooze tabs for later viewing with flexible scheduling options",
  "main": "background.js",
  "scripts": {
    "test": "jest",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "lint": "eslint .",
    "build": "npm run lint && npm test",
    "screenshots": "node scripts/capture-screenshots.js",
    "package": "node scripts/build-zip.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cory-nava/snoozed-tabs-extension.git"
  },
  "keywords": [
    "chrome-extension",
    "tab-management",
    "productivity",
    "snooze",
    "browser-extension",
    "tab-organizer"
  ],
  "author": "Cory Trimm <corytrimm@navapbc.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cory-nava/snoozed-tabs-extension/issues"
  },
  "homepage": "https://github.com/cory-nava/snoozed-tabs-extension#readme",
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/preset-env": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "babel-jest": "^30.5.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/tests/globalSetup.js",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/e2e/"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "background/**/*.js",
      "utils/**/*.js",
      "popup/**/*.js"
    ]
  }
}
